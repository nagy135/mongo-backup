#!/bin/bash

set -u

backup_directory=${BACKUP_DIRECTORY:-/backups}

heading() {
  gum style --foreground 212 --border double --border-foreground 212 --align center --width 52 --padding '1 2' 'MongoDB Backup'
}

success() {
  gum log --level info "$1"
}

failure() {
  gum log --level error "$1" >&2
}

select_backup() {
  local backups choice selected_backup size title=${1:-'Select a backup'}

  mapfile -t backups < <(find "$backup_directory" -maxdepth 1 -type f -name '*.archive.gz' -print | sort -r)

  if ((${#backups[@]} == 0)); then
    failure "No backup archives found in $backup_directory"
    return
  fi

  local options=()
  for choice in "${!backups[@]}"; do
    size=$(stat --format='%s' "${backups[$choice]}")
    options+=("$((choice + 1))  $(basename "${backups[$choice]}")  ${size} bytes")
  done

  if ! selected_backup=$(printf '%s\n' "${options[@]}" | gum choose \
    --header "$title" \
    --height 10 \
    --cursor.foreground 212 \
    --selected.foreground 212); then
    return
  fi
  choice=${selected_backup%% *}
  printf '%s\n' "${backups[$((choice - 1))]}"
}

rename_backup() {
  local backup filename renamed_backup suffix

  if ! backup=$(select_backup 'Select a backup to rename'); then
    return
  fi

  if ! suffix=$(gum input --prompt 'Suffix: ' --placeholder 'e.g. before-import'); then
    return
  fi
  if [[ ! $suffix =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
    failure 'Suffix must contain only letters, numbers, hyphens, and underscores'
    return 1
  fi

  filename=$(basename "$backup")
  renamed_backup="${backup%.archive.gz}-${suffix}.archive.gz"
  if [[ -e $renamed_backup ]]; then
    failure "$(basename "$renamed_backup") already exists"
    return 1
  fi

  mv "$backup" "$renamed_backup"
  success "Renamed $filename to $(basename "$renamed_backup")"
}

manage_backups() {
  local action backup size

  while true; do
    clear
    heading
    echo
    gum style --foreground 212 --bold 'Available backups'
    while IFS= read -r backup; do
      size=$(stat --format='%s' "$backup")
      printf '%s  %s bytes\n' "$(gum style --foreground 255 "$(basename "$backup")")" "$(gum style --faint "$size")"
    done < <(list-backups)

    if ! action=$(gum choose --height 4 'r  Rename a backup' 'b  Back'); then
      return
    fi
    case $action in
      r*) rename_backup; read -r -p 'Press Enter to continue...' ;;
      b*) return ;;
    esac
  done
}

restore_backup() {
  local collection_count preflight_output selected_backup status=0

  if ! selected_backup=$(select_backup 'Select a backup to restore'); then
    return
  fi

  gum spin --spinner dot --title 'Checking archive contents...' -- \
    bash -c 'mongorestore --uri="$1" --archive="$2" --gzip --dryRun --verbose > /tmp/backup-preflight.log 2>&1' _ \
    "${MONGODB_URI:?MONGODB_URI must be set}" "$selected_backup"
  status=$?
  preflight_output=$(< /tmp/backup-preflight.log)
  rm -f /tmp/backup-preflight.log
  if ((status != 0)); then
    echo "$preflight_output" >&2
    failure 'Archive preflight failed; restore cancelled'
    return "$status"
  fi

  collection_count=$(grep -c 'found collection .* bson to restore to' <<< "$preflight_output")
  if ((collection_count == 0)); then
    failure 'Archive contains no documents; restore cancelled'
    return 1
  fi
  success "Archive contains $collection_count collections"

  gum style --foreground 196 --bold 'Warning: restoring drops and replaces matching collections.'
  gum style --faint "Archive: $(basename "$selected_backup")"
  if ! gum confirm --affirmative 'Restore' --negative 'Cancel' 'Restore this backup?'; then
    success 'Restore cancelled'
    return
  fi

  if ! mkdir /tmp/mongodb-backup.lock 2>/dev/null; then
    failure 'Another backup or restore operation is already running'
    return 1
  fi

  trap 'rmdir /tmp/mongodb-backup.lock' RETURN
  trap 'rmdir /tmp/mongodb-backup.lock; exit 130' INT TERM
  if gum spin --spinner dot --title 'Restoring backup...' --show-output=false -- \
    mongorestore \
      --uri="${MONGODB_URI:?MONGODB_URI must be set}" \
      --archive="$selected_backup" \
      --gzip \
      --drop; then
    success 'Restore completed'
  else
    status=$?
    failure 'Restore failed'
  fi
  trap - INT TERM
  return "$status"
}

while true; do
  clear
  heading
  echo
  if ! action=$(gum choose \
    --header 'Choose an action' \
    --height 6 \
    --cursor.foreground 212 \
    --selected.foreground 212 \
    'Create backup now' \
    'Restore a backup' \
    'Manage backups' \
    'Exit'); then
    exit 0
  fi

  case $action in
    'Create backup now') gum spin --spinner dot --title 'Creating backup...' --show-output=false -- backup-now; success 'Backup completed'; read -r -p 'Press Enter to continue...' ;;
    'Restore a backup') restore_backup; read -r -p 'Press Enter to continue...' ;;
    'Manage backups') manage_backups ;;
    'Exit') exit 0 ;;
  esac
done
